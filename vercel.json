{
    "framework": "vite",
    "redirects": [
        {
            "source": "/(.*)",
            "has": [{ "type": "host", "value": "www.saop.cc" }],
            "destination": "https://saop.cc/$1",
            "permanent": true
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=31536000; includeSubDomains; preload"
                }
            ]
        }
    ]
}
