# 站点信息
NUXT_PUBLIC_SITE_NAME = "我的主页" # 名称
NUXT_PUBLIC_SITE_AUTHOR = "作者" # 作者
NUXT_PUBLIC_SITE_KEYWORDS = "个人主页,主页" # 关键词
NUXT_PUBLIC_SITE_DES = "一个简单的个人主页" # 站点简介
NUXT_PUBLIC_SITE_URL = "example.com" # 站点地址
NUXT_PUBLIC_SITE_LOGO = "/images/icon/favicon.ico" # 站点主图标
NUXT_PUBLIC_SITE_MAIN_LOGO = "/images/icon/logo.png" # 主页图标
NUXT_PUBLIC_SITE_APPLE_LOGO = "/images/icon/apple-touch-icon.png" # Apple 端图标
NUXT_PUBLIC_SITE_OG_IMAGE = "/images/icon/512.png" # OG 社交分享图片 (相对路径，拼接 SITE_URL)
NUXT_PUBLIC_SITE_THEME_COLOR = "#424242" # 主题色 (浏览器地址栏、PWA 主题色)

# 简介文本
NUXT_PUBLIC_DESC_HELLO = "Hello World !"
NUXT_PUBLIC_DESC_TEXT = "一个简单的个人主页"
NUXT_PUBLIC_DESC_HELLO_OTHER = "Oops !"
NUXT_PUBLIC_DESC_TEXT_OTHER = "哎呀，这都被你发现了（ 再点击一次可关闭 ）"

# 社交链接
## 请在 assets/socialLinks.json 文件中配置

# 网站链接
## 请在 assets/siteLinks.json 文件中配置
## 网站链接的图标名称可前往 https://lucide.dev/icons 自行挑选并在 components/Links.vue 中引入

# 壁纸源
## 本地壁纸数量 (对应 public/images/background1.jpg ~ backgroundN.jpg)
NUXT_PUBLIC_BG_LOCAL_COUNT = 10
## 每日一图 API (留空使用默认)
NUXT_PUBLIC_BG_BING_URL = ""
## 随机风景 API (留空使用默认)
NUXT_PUBLIC_BG_SCENERY_URL = ""
## 随机动漫 API (留空使用默认)
NUXT_PUBLIC_BG_ANIME_URL = ""

# 建站日期
## 若不需要，请设为空即可
## 请按照 YYYY-MM-DD 格式填写或者仅填写年份 YYYY
NUXT_PUBLIC_SITE_START = "2024-01-01"

# ICP 备案号
## 若不需要，请设为空即可
NUXT_PUBLIC_SITE_ICP = ""
# 备案跳转链接 (默认: https://beian.miit.gov.cn)
## 萌 ICP 备案可填 https://icp.gov.moe/
NUXT_PUBLIC_SITE_ICP_URL = "https://beian.miit.gov.cn"

# 歌曲 API 地址
## 请参照 https://github.com/xizeyoupan/Meting-API#deno-deploy 进行 API 服务部署
## 此处提供的服务可能会超量从而无法访问，请自行部署
## 若使用 QQ 音乐歌单，歌曲数量最好不要超出 50 首
NUXT_PUBLIC_SONG_API = "https://api-meting.example.com/api"
# 歌曲服务器 ( netease-网易云, tencent-qq音乐 )
NUXT_PUBLIC_SONG_SERVER = "netease"
# 播放类型 ( song-歌曲, playlist-播放列表, album-专辑, search-搜索, artist-艺术家 )
NUXT_PUBLIC_SONG_TYPE = "playlist"
# 播放 ID ( 若无需播放器，请设为空即可 )
NUXT_PUBLIC_SONG_ID = ""

# Artalk 评论
## 服务端地址
NUXT_PUBLIC_ARTALK_SERVER = "https://artalk.example.com"
## 站点名称 (需与 Artalk 后台配置一致)
NUXT_PUBLIC_ARTALK_SITE = "我的主页"

# 全局设置默认值 (用户修改后以 localStorage 为准)
# 壁纸类型: 0=默认 1=每日一图 2=随机风景 3=随机动漫
NUXT_PUBLIC_DEFAULT_COVER_TYPE = "0"
# 建站日期显示
NUXT_PUBLIC_DEFAULT_SITE_START_SHOW = "true"
# 音乐点击打开面板
NUXT_PUBLIC_DEFAULT_MUSIC_CLICK = "false"
# 底栏歌词显示
NUXT_PUBLIC_DEFAULT_PLAYER_LRC_SHOW = "true"
# 底栏背景模糊
NUXT_PUBLIC_DEFAULT_FOOTER_BLUR = "true"
# 自动播放
NUXT_PUBLIC_DEFAULT_PLAYER_AUTOPLAY = "false"
# 循环模式: all=列表 one=单曲 none=不循环
NUXT_PUBLIC_DEFAULT_PLAYER_LOOP = "all"
# 播放顺序: list=顺序 random=随机
NUXT_PUBLIC_DEFAULT_PLAYER_ORDER = "random"
